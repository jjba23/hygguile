(define-public (toggle-dark-theme-js) (quote ((script (@ (type "text/javascript") (defer "")) "/*\n  hygguile - cozy and professional user-interfaces for everyone\n\n  Copyright © Josep Bigorra <jjbigorra@gmail.com>\n\n  hygguile is free software: you can redistribute it and/or modify\n  it under the terms of the Lesser GNU General Public License as published by\n  the Free Software Foundation, either version 3 of the License, or\n  (at your option) any later version.\n\n  hygguile is distributed in the hope that it will be useful,\n  but WITHOUT ANY WARRANTY; without even the implied warranty of\n  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n  Lesser GNU General Public License for more details.\n\n  You should have received a copy of the Lesser GNU General Public License\n  along with hygguile.  If not, see <https://www.gnu.org/licenses/>.\n*/\n\nfunction hygguileSaveDarkThemePreference(preference) {\n  document.documentElement.setAttribute('data-theme', preference)\n  localStorage.setItem('data-theme', preference)\n}\n\nfunction hygguileToggleDarkTheme() {\n  const currentTheme = document.documentElement.getAttribute('data-theme')\n  if (currentTheme == null) {\n    //\n    // by default set dark since hygguile has a light theme by default\n    //\n    hygguileSaveDarkThemePreference('dark')\n  } else {\n    if (currentTheme == 'dark') {\n      hygguileSaveDarkThemePreference('light')\n    } else {\n      hygguileSaveDarkThemePreference('dark')\n    }\n  }\n}\n"))))

(define-public (tray-js) (quote ((script (@ (type "text/javascript") (defer "")) "/*\n  hygguile - cozy and professional user-interfaces for everyone\n\n  Copyright © Josep Bigorra <jjbigorra@gmail.com>\n\n  hygguile is free software: you can redistribute it and/or modify\n  it under the terms of the Lesser GNU General Public License as published by\n  the Free Software Foundation, either version 3 of the License, or\n  (at your option) any later version.\n\n  hygguile is distributed in the hope that it will be useful,\n  but WITHOUT ANY WARRANTY; without even the implied warranty of\n  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n  Lesser GNU General Public License for more details.\n\n  You should have received a copy of the Lesser GNU General Public License\n  along with hygguile.  If not, see <https://www.gnu.org/licenses/>.\n*/\n\n/*\n  The tray controls: the two things a page asks of a whole tray of cards at\n  once, which order it is in and whether all of it is open. Both are declared\n  in the markup by `sort-control' and `disclosure-controls', so the only\n  JavaScript a page carries is the call each button already makes.\n\n  Ordering is data, not code. A button reaches this file as\n\n    hygguileSortTray(this, 'title')\n\n  and the tray it orders is whichever container the button's group names in\n  its `data-hg-sort-target'. The items are ordered by their `data-title'\n  attribute --  numerically when both values are numbers, so data-order=\"10\"\n  follows data-order=\"9\" instead of sorting in front of it, and\n  alphabetically otherwise. The sort is stable, so items that compare equal\n  keep the order they are already in. A mode that no item carries is the\n  tray's own order: the items go back to the order the page wrote them in,\n  which is what a \"Page order\" button is for and why it needs no attribute\n  anywhere.\n*/\n\n(function () {\n  /* The order each tray was written in, read once the document is parsed:\n     by the time a button has been clicked it is too late to ask. */\n  const written = new Map()\n\n  const writtenOrder = (container) => written.get(container)\n    || Array.prototype.slice.call(container.children)\n\n  const asNumber = (text) => {\n    const trimmed = text.trim()\n    return trimmed !== '' && !isNaN(Number(trimmed)) ? Number(trimmed) : null\n  }\n\n  const compare = (mode) => (a, b) => {\n    const left = a.getAttribute('data-' + mode) || ''\n    const right = b.getAttribute('data-' + mode) || ''\n    const leftNumber = asNumber(left)\n    const rightNumber = asNumber(right)\n    if (leftNumber !== null && rightNumber !== null) {\n      return leftNumber - rightNumber\n    }\n    return left.localeCompare(right)\n  }\n\n  const groupOf = (button) => button.closest('[data-hg-sort-target]')\n\n  /* One button of the group is the order in force; the stylesheet draws that\n     as the pressed one, and a screen reader reads it out. */\n  const mark = (button, group) => {\n    Array.prototype.forEach.call(group.querySelectorAll('button'),\n                                 (other) => {\n                                   other.setAttribute('aria-pressed',\n                                                      other === button\n                                                        ? 'true' : 'false')\n                                 })\n  }\n\n  window.hygguileSortTray = (button, mode) => {\n    const group = groupOf(button)\n    const container = group\n      && document.getElementById(group.getAttribute('data-hg-sort-target'))\n    if (!container) {\n      return\n    }\n    const items = Array.prototype.slice.call(container.children)\n    const carries = items.some((item) => item.hasAttribute('data-' + mode))\n    const ordered = carries\n      ? items.sort(compare(mode))\n      : writtenOrder(container).slice()\n    ordered.forEach((item) => container.appendChild(item))\n    mark(button, group)\n  }\n\n  window.hygguileToggleTray = (open, selector) => {\n    Array.prototype.forEach.call(document.querySelectorAll(selector),\n                                 (details) => {\n                                   details.open = open\n                                 })\n  }\n\n  /* The tray is in the order the page wrote it in, and the first button of a\n     group is the order it opens in, so a page states its own order by writing\n     that mode first. */\n  document.addEventListener('DOMContentLoaded', () => {\n    Array.prototype.forEach.call(\n      document.querySelectorAll('[data-hg-sort-target]'),\n      (group) => {\n        const container = document.getElementById(\n          group.getAttribute('data-hg-sort-target'))\n        if (container) {\n          written.set(container, Array.prototype.slice.call(container.children))\n        }\n        const first = group.querySelector('button')\n        if (first) {\n          mark(first, group)\n        }\n      })\n  })\n})()\n"))))

(define-public (interactions-js) (quote ((script (@ (type "text/javascript") (defer "")) "/*\n  hygguile - cozy and professional user-interfaces for everyone\n\n  Copyright © Josep Bigorra <jjbigorra@gmail.com>\n\n  hygguile is free software: you can redistribute it and/or modify\n  it under the terms of the Lesser GNU General Public License as published by\n  the Free Software Foundation, either version 3 of the License, or\n  (at your option) any later version.\n*/\n\n/*\n  The small interactions every page otherwise re-implements: keeping focus\n  inside an open overlay, moving through a roving tab group, marking the\n  section a reader is in, copying a value, and announcing a resize.\n\n  Everything here is progressive. A page that never loads this file still has\n  working drawers, menus and copyable text (the copy button hides itself, and\n  the value is shown as selectable text instead); this file only makes the\n  experience better, never possible.\n*/\n\n(function () {\n  const focusable = (root) => Array.from(root.querySelectorAll(\n    'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex=\"-1\"])'\n  )).filter((node) => node.offsetParent !== null || node === document.activeElement)\n\n  let lastTrigger = null\n  let trapWasOpen = false\n\n  /* A `:target` overlay is shown by the URL, so the hash is the state.\n     When one opens, move focus into it; while it is open, Tab cycles inside\n     it and Escape closes it by clearing the hash. */\n  const syncTrap = () => {\n    const open = Array.from(document.querySelectorAll('[data-hg-focus-trap]'))\n      .find((node) => node.id && ('#' + node.id) === window.location.hash)\n    document.querySelectorAll('[data-hg-focus-trap]').forEach((node) => {\n      if (node !== open) node.removeAttribute('data-hg-trap-active')\n    })\n    if (!open) {\n      if (trapWasOpen && lastTrigger) lastTrigger.focus()\n      trapWasOpen = false\n      return\n    }\n    if (open.hasAttribute('data-hg-trap-active')) return\n    open.setAttribute('data-hg-trap-active', '')\n    trapWasOpen = true\n    lastTrigger = document.activeElement\n    const items = focusable(open)\n    if (items.length) items[0].focus()\n    open.addEventListener('keydown', (event) => {\n      if (event.key === 'Escape') {\n        event.preventDefault()\n        window.location.hash = '#'\n        return\n      }\n      if (event.key !== 'Tab') return\n      const now = focusable(open)\n      if (!now.length) return\n      const first = now[0]\n      const last = now[now.length - 1]\n      if (event.shiftKey && document.activeElement === first) {\n        event.preventDefault()\n        last.focus()\n      } else if (!event.shiftKey && document.activeElement === last) {\n        event.preventDefault()\n        first.focus()\n      }\n    }, { once: false })\n  }\n\n  window.addEventListener('hashchange', syncTrap)\n  document.addEventListener('DOMContentLoaded', syncTrap)\n\n  /* Roving tabindex: one tab stop for the group, arrow keys move inside it. */\n  const roving = (group) => {\n    const items = Array.from(group.querySelectorAll('[data-hg-roving-item]'))\n    if (!items.length) return\n    const selected = items.findIndex((item) => item.getAttribute('aria-selected') === 'true')\n    const start = selected >= 0 ? selected : 0\n    items.forEach((item, index) => { item.tabIndex = index === start ? 0 : -1 })\n    group.addEventListener('keydown', (event) => {\n      const keys = ['ArrowRight', 'ArrowDown', 'ArrowLeft', 'ArrowUp', 'Home', 'End']\n      if (!keys.includes(event.key)) return\n      event.preventDefault()\n      const current = items.indexOf(document.activeElement)\n      let next = current\n      if (event.key === 'Home') next = 0\n      else if (event.key === 'End') next = items.length - 1\n      else if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (current + 1) % items.length\n      else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (current - 1 + items.length) % items.length\n      items.forEach((item, index) => { item.tabIndex = index === next ? 0 : -1 })\n      items[next].focus()\n    })\n  }\n  document.querySelectorAll('[data-hg-roving]').forEach(roving)\n\n  /* Scroll spy: mark the section link a reader is currently inside. The\n     section ids come from the rail's own links, so a page adds nothing. */\n  const spy = (nav) => {\n    const links = Array.from(nav.querySelectorAll('a[href^=\"#\"]'))\n    if (!links.length || !('IntersectionObserver' in window)) return\n    const sections = links.map((link) => document.getElementById(link.getAttribute('href').slice(1))).filter(Boolean)\n    if (!sections.length) return\n    const mark = (id) => {\n      links.forEach((link) => {\n        if (link.getAttribute('href') === '#' + id) link.setAttribute('aria-current', 'true')\n        else link.removeAttribute('aria-current')\n      })\n    }\n    const observer = new IntersectionObserver((entries) => {\n      entries.forEach((entry) => {\n        if (entry.isIntersecting) mark(entry.target.id)\n      })\n    }, { rootMargin: '-20% 0px -70% 0px' })\n    sections.forEach((section) => observer.observe(section))\n  }\n  document.querySelectorAll('[data-hg-scroll-spy]').forEach(spy)\n\n  /* Copy buttons: the value is data, never parsed as markup, and the label\n     says what happened for a moment before returning. */\n  document.addEventListener('click', (event) => {\n    const button = event.target.closest('[data-hg-copy]')\n    if (!button) return\n    const value = button.getAttribute('data-hg-copy') || ''\n    const label = button.getAttribute('data-hg-copy-label') || 'Copy'\n    const copied = button.getAttribute('data-hg-copied-label') || 'Copied'\n    if (!navigator.clipboard) return\n    navigator.clipboard.writeText(value).then(() => {\n      button.setAttribute('aria-label', copied)\n      const text = button.querySelector('span:not(