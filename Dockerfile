# syntax=docker/dockerfile:1.7

# hygguile
#
# Generated by gen_containers.py; keep in step with packaging/.

FROM opensuse/tumbleweed:latest AS builder

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile guile-devel gcc make autoconf automake libtool \
        pkg-config gawk gnulib-devel gettext-tools findutils \
        libcurl-devel sqlite3-devel guile-json guile-gcrypt \
        guile-fibers tar gzip; \
    zypper clean --all

# Build the Guile libraries openSUSE does not package.  They are
# copied into the runtime with the project, so the image needs no
# extra repository or post-install step.

ADD https://download.savannah.gnu.org/releases/guile-lib/guile-lib-0.2.8.1.tar.gz /tmp/guile-lib.tar.gz
RUN set -eu; \
    mkdir -p "/tmp/guile-lib"; \
    tar xzf "/tmp/guile-lib.tar.gz" -C "/tmp/guile-lib" --strip-components=1; \
    cd "/tmp/guile-lib"; \
    ./configure --prefix=/usr --with-guile-site=yes; \
    make -j"$(nproc)"; \
    make install

ADD https://codeberg.org/elb/guile-uuid/archive/v0.9.1.tar.gz /tmp/guile-uuid.tar.gz
RUN set -eu; \
    mkdir -p "/tmp/guile-uuid"; \
    tar xzf "/tmp/guile-uuid.tar.gz" -C "/tmp/guile-uuid" --strip-components=1; \
    install -d /usr/share/guile/site/3.0; \
    cp -r "/tmp/guile-uuid/uuid" /usr/share/guile/site/3.0/

COPY src/hygguile ./src/hygguile

RUN set -eu; \
    site="/usr/share/guile/site/3.0"; \
    install -d "$site/hygguile"; \
    cp -r "src/hygguile/." "$site/hygguile/"

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------

FROM opensuse/tumbleweed:latest AS runtime

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="hygguile" \
      org.opencontainers.image.description="Accessible server-rendered UI components for Guile Scheme" \
      org.opencontainers.image.url="https://codeberg.org/jjba23/hygguile" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}"

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile \
        ca-certificates; \
    zypper clean --all

COPY --from=builder /usr/share/guile/site /usr/share/guile/site
COPY --from=builder /usr/lib64/guile /usr/lib64/guile
RUN ldconfig

ENTRYPOINT ["guile"]
